# ─────────────────────────────────────────────────────────────────────────────
# dariopicardi.com — environment variables
# Copy to .env for local development. Never commit .env. On Netlify, set these
# under Site configuration → Environment variables.
# ─────────────────────────────────────────────────────────────────────────────

# Public (injected at build time; safe to expose)
PUBLIC_SITE_URL=https://dariopicardi.com
# Google Tag Manager container. Empty = no third-party script loads at all.
PUBLIC_GTM_ID=
# Cloudflare Turnstile site key (optional bot protection on the contact form).
PUBLIC_TURNSTILE_SITE_KEY=

# Server only (never exposed to the browser)
# Secret used to sign the anti-spam form token. Any long random string.
CONTACT_FORM_SECRET=change-me-to-a-long-random-string
# Cloudflare Turnstile secret key (required only if PUBLIC_TURNSTILE_SITE_KEY is set).
TURNSTILE_SECRET_KEY=
# Where normalized submissions are forwarded (CRM webhook: HubSpot, Follow Up Boss, Zapier/Make…).
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_TOKEN=
# Email notification via Resend (https://resend.com) — optional.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=website@dariopicardi.com
# Comma-separated list of origins allowed to POST to /api/contact (defaults to PUBLIC_SITE_URL).
CONTACT_ALLOWED_ORIGINS=
