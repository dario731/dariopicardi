---
import BaseLayout from '@layouts/BaseLayout.astro';
import EditorialHero from '@components/editorial/EditorialHero.astro';
import StageScroller from '@components/cinematic/StageScroller.astro';
import ImageNarrative from '@components/editorial/ImageNarrative.astro';
import PullQuote from '@components/editorial/PullQuote.astro';
import CtaBand from '@components/editorial/CtaBand.astro';
import Title from '@components/ui/Title.astro';
import Arrow from '@components/ui/Arrow.astro';
import sea from '@assets/images/dario-sea-miami.jpg';
import skyline from '@assets/images/dario-miami-skyline.jpg';
import portrait from '@assets/images/portrait-dario-tmp.jpg';
import { getCopy } from '@i18n/index';
import { storyStages } from '@data/stages';
import { webPageLd, breadcrumbLd } from '@lib/seo';
import type { ImageMetadata } from 'astro';

const s = getCopy('en').story;
const path = '/story';
const jsonLd = [webPageLd({ name: s.seo.title, description: s.seo.description, path, type: 'ProfilePage' }), breadcrumbLd([{ name: 'Story', path }])];
type Chapter = { id: string; n: string; title: string; kicker: string; paragraphs: readonly string[]; pull?: string; facts?: readonly string[]; placeholder?: string; cta?: { label: string; href: string }; imageAlt?: string };
const chapters = s.chapters as readonly Chapter[];
const images: Record<string, { image: ImageMetadata; alt: string; ratio: '4x5' | '3x4' | '16x9'; treatment: 'mono' | 'warm' | 'none'; note?: string }> = {
  world: { image: skyline, alt: 'Dario Picardi on the water off Miami with the skyline behind him', ratio: '16x9', treatment: 'warm', note: 'Miami · the city that became home' },
  life: { image: sea, alt: 'Dario Picardi at sea off Miami', ratio: '4x5', treatment: 'warm', note: 'At sea · Miami' },
  instinct: { image: portrait, alt: 'Dario Picardi', ratio: '4x5', treatment: 'mono', note: 'Portrait FOUNDER-01 (placeholder)' },
};
---

<BaseLayout title={`${s.seo.title} — Dario Picardi`} description={s.seo.description} {path} pageType="story" type="profile" {jsonLd}>
  <EditorialHero eyebrow={s.hero.eyebrow} title={s.hero.title} lede={s.hero.lede} crumbs={[{ name: 'Story', path }]} compact>
    <p class="toc-hint num" data-reveal><span>Nine stages</span><span class="toc-hint__line" aria-hidden="true"></span><a href="#depth">{s.chaptersLabel} in full</a></p>
  </EditorialHero>

  <StageScroller id="stages" eyebrow={s.hero.eyebrow} stages={storyStages('en')} />

  <section class="depth section g-ivory" id="depth" aria-labelledby="depth-title">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow eyebrow--rule eyebrow--accent" data-reveal>{s.depth.eyebrow}</p>
        <div data-reveal><Title as="h2" id="depth-title" class="t-1" text={s.depth.title} /></div>
        <p class="lede muted" data-reveal>{s.depth.body}</p>
      </div>
      <div class="depth__list">
        {chapters.map((ch) => {
          const img = images[ch.id];
          return (
            <details class="dch" id={ch.id} data-reveal>
              <summary class="dch__sum">
                <span class="num dch__n">{ch.n}</span>
                <span class="dch__title serif">{ch.title}</span>
                <span class="dch__kicker small muted">{ch.kicker}</span>
                <span class="dch__icon" aria-hidden="true"></span>
              </summary>
              <div class="dch__body">
                <div class="dch__media">
                  {img ? (
                    <ImageNarrative image={img.image} alt={img.alt} ratio={img.ratio} treatment={img.treatment} note={img.note} sizes="(min-width: 1024px) 34vw, 100vw" />
                  ) : (
                    <ImageNarrative ratio="4x5" placeholder={ch.placeholder} manifestId={`STORY-${ch.n}`} alt="" />
                  )}
                  {ch.facts && <ul class="dch__facts" role="list">{ch.facts.map((f) => <li>{f}</li>)}</ul>}
                </div>
                <div class="dch__text">
                  <div class="prose">{ch.paragraphs.map((p, j) => <p class:list={{ 'dch__lead': j === 0 }}>{p}</p>)}</div>
                  {ch.pull && <PullQuote text={ch.pull} />}
                  {ch.cta && <p><a class="link" href={ch.cta.href} data-track="navigation_click" data-track-cta-name={ch.id}>{ch.cta.label}<Arrow /></a></p>}
                </div>
              </div>
            </details>
          );
        })}
      </div>
    </div>
  </section>

  <CtaBand ground="lino" title={s.closing.title} primary={{ ...s.closing.cta, name: 'global_career' }} secondary={{ ...s.closing.secondary, name: 'connect' }} />
</BaseLayout>

<script>
  // Open the chapter targeted by the URL hash (deep links from Home).
  function openHash() {
    const id = location.hash.slice(1);
    if (!id) return;
    const d = document.getElementById(id);
    if (d instanceof HTMLDetailsElement) { d.open = true; }
  }
  openHash();
  document.addEventListener('astro:page-load', openHash);
  window.addEventListener('hashchange', openHash);
</script>

<style>
  .toc-hint { display: inline-flex; align-items: center; gap: 0.8rem; margin-top: var(--s-3); text-transform: uppercase; }
  .toc-hint__line { width: 2rem; height: 1px; background: var(--accent); }
  .toc-hint a { color: var(--fg-muted); border-bottom: 1px solid var(--accent-soft); }
  .depth__list { display: grid; border-top: 1px solid var(--line); }
  .dch { border-bottom: 1px solid var(--line); scroll-margin-top: 5.5rem; }
  .dch__sum { display: grid; grid-template-columns: 3rem 1fr auto; grid-template-areas: 'n title icon' 'n kicker icon'; align-items: center; column-gap: var(--s-4); row-gap: 0.15rem; padding: 1.25rem 0; cursor: pointer; list-style: none; }
  .dch__sum::-webkit-details-marker { display: none; }
  .dch__n { grid-area: n; color: var(--accent); }
  .dch__title { grid-area: title; font-size: clamp(1.5rem, 2.8vw, 2.2rem); line-height: 1.1; transition: color var(--dur-1); }
  .dch__kicker { grid-area: kicker; }
  .dch__icon { grid-area: icon; position: relative; width: 2.2rem; height: 2.2rem; border: 1px solid var(--line); border-radius: 50%; transition: border-color var(--dur-1), transform var(--dur-2) var(--ease-out); }
  .dch__icon::before, .dch__icon::after { content: ''; position: absolute; left: 50%; top: 50%; width: 0.8rem; height: 1px; background: currentColor; transform: translate(-50%, -50%); }
  .dch__icon::after { transform: translate(-50%, -50%) rotate(90deg); transition: transform var(--dur-2) var(--ease-out); }
  .dch[open] .dch__icon::after { transform: translate(-50%, -50%) rotate(0deg); }
  .dch[open] .dch__icon, .dch__sum:hover .dch__icon { border-color: var(--accent); }
  .dch__sum:hover .dch__title { color: var(--accent); }
  .dch__body { display: grid; gap: var(--s-6); padding: var(--s-4) 0 var(--s-8); }
  .dch__text { display: grid; gap: var(--s-5); }
  .dch__lead { font-family: var(--font-serif); font-size: calc(var(--fs-lede) * 1.12); line-height: 1.42; }
  .dch__facts { display: grid; margin-top: var(--s-4); border-top: 1px solid var(--accent); }
  .dch__facts li { padding: 0.65rem 0; border-bottom: 1px solid var(--line); font-size: var(--fs-small); color: var(--fg-muted); }
  @media (min-width: 1024px) {
    .dch__body { grid-template-columns: 5fr 7fr; column-gap: calc(var(--gutter) * 2.5); align-items: start; padding-left: calc(3rem + var(--s-4)); }
  }
</style>
