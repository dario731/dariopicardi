---
/**
 * Home — a sequence of frames, not a page.
 * Hero → ticker → journey (map stages) → numbers → six words → photograph →
 * Business/Wealth/Lifestyle → one invitation. A few lines of text in total.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/home/Hero.astro';
import Ticker from '@components/cinematic/Ticker.astro';
import StageScroller from '@components/cinematic/StageScroller.astro';
import KineticFrames from '@components/cinematic/KineticFrames.astro';
import PhotoFrame from '@components/cinematic/PhotoFrame.astro';
import CtaBand from '@components/editorial/CtaBand.astro';
import sea from '@assets/images/dario-sea-miami.jpg';
import { getCollection } from 'astro:content';
import { getCopy } from '@i18n/index';
import { homeStages } from '@data/stages';
import { webPageLd } from '@lib/seo';
import { site } from '@data/site';
import type { Frame } from '@components/cinematic/KineticFrames.astro';

const copy = getCopy('en');
const h = copy.home;
const jsonLd = [webPageLd({ name: h.seo.title, description: h.seo.description, path: '/', type: 'ProfilePage', image: `${site.url}${site.seo.defaultImage}` })];

const stats = (await getCollection('stats')).filter((s) => s.data.home).sort((a, b) => a.data.order - b.data.order);
const numberFrames: Frame[] = stats.filter((s) => /\d/.test(s.data.value) && s.id !== 'founded' && s.id !== 'degrees').map((s) => ({ id: s.id, kind: 'number', value: s.data.value, label: s.data.label }));
const words = (await getCollection('framework')).sort((a, b) => a.data.order - b.data.order);
const wordFrames: Frame[] = words.map((w) => ({ id: w.id, kind: 'word', text: w.data.word, label: w.data.line }));
const journeyFrames: Frame[] = [
  ...h.frames.journey.map((s, i) => ({ id: s.id, kind: 'step' as const, text: s.text, label: s.label, tag: `The Investor Journey™ · ${i + 1} / 3` })),
  { id: 'bizstyle', kind: 'statement', text: h.frames.bizStyle.text, label: h.frames.bizStyle.label, tag: 'BIZ & STYLE', cta: h.frames.bizStyle.cta },
];
---

<BaseLayout title={h.seo.title} description={h.seo.description} path="/" pageType="home" type="profile" {jsonLd}>
  <Hero copy={h.hero} />
  <Ticker items={h.global.strip} />
  <section class="jhead g-ivory" aria-label={h.journey.eyebrow}>
    <div class="container"><p class="eyebrow eyebrow--rule eyebrow--accent" data-reveal>{h.journey.eyebrow}</p></div>
  </section>
  <StageScroller id="journey" eyebrow={h.journey.eyebrow} stages={homeStages('en')} />
  <KineticFrames id="proof" label={h.proof.eyebrow} frames={numberFrames} ground="lino" perFrame={0.6} />
  <KineticFrames id="words" label={h.framework.eyebrow} frames={wordFrames} ground="ivory" perFrame={0.5} />
  <PhotoFrame id="family" image={sea} alt={h.personal.imageAlt} eyebrow={h.personal.eyebrow} title={h.personal.title} cta={h.personal.cta} position="center 30%" />
  <KineticFrames id="ecosystem" label={h.bizStyle.eyebrow} frames={journeyFrames} ground="ivory" perFrame={0.6} />
  <CtaBand id="closing" ground="lino" title={h.closing.title} primary={{ ...h.closing.cta, name: 'connect' }} />
</BaseLayout>

<style>
  .jhead { padding-top: var(--s-7); padding-bottom: var(--s-4); }
</style>
