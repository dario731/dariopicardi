---
/**
 * Journey — the signature interaction. A single route line draws down the
 * page as the reader scrolls through six chapters, from Italian roots to the
 * person. Markers light as the line passes them. Pure SVG + one rAF loop; on
 * reduced motion the line is simply drawn.
 */
import Title from '@components/ui/Title.astro';
import Arrow from '@components/ui/Arrow.astro';
import type { Copy } from '@i18n/index';
interface Props { copy: Copy['home']['journey'] }
const { copy } = Astro.props;
---

<section class="jr section g-ivory" id="journey" aria-labelledby="journey-title" data-journey>
  <div class="container jr__grid">
    <div class="jr__head">
      <p class="eyebrow eyebrow--rule eyebrow--accent" data-reveal>{copy.eyebrow}</p>
      <div data-reveal><Title as="h2" id="journey-title" class="t-2" text={copy.title} /></div>
    </div>

    <ol class="jr__list" role="list">
      <svg class="jr__route" aria-hidden="true" focusable="false" preserveAspectRatio="none" viewBox="0 0 2 1000">
        <line class="jr__track" x1="1" y1="0" x2="1" y2="1000" />
        <line class="jr__line" x1="1" y1="0" x2="1" y2="1000" pathLength="100" data-route-line />
      </svg>
      {copy.chapters.map((c, i) => (
        <li class="jr__item" data-route-item style={`--i:${i}`}>
          <a class="jr__link" href={c.href} data-track="navigation_click" data-track-cta-name={`journey_${c.n}`}>
            <span class="jr__marker" aria-hidden="true"></span>
            <span class="num jr__n">{c.n}</span>
            <span class="jr__body">
              <span class="jr__title serif">{c.title}</span>
              <span class="jr__line-copy">{c.line}</span>
              <span class="link link--sm jr__more">Read<Arrow /></span>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  import { onScrollProgress, reducedMotion } from '@lib/reveal';
  function initJourney() {
    const root = document.querySelector<HTMLElement>('[data-journey]');
    if (!root || root.dataset.bound) return;
    root.dataset.bound = '1';
    const line = root.querySelector<SVGLineElement>('[data-route-line]');
    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-route-item]'));
    const list = root.querySelector<HTMLElement>('.jr__list');
    if (!line || !list) return;
    if (reducedMotion()) {
      line.style.strokeDashoffset = '0';
      items.forEach((it) => it.classList.add('is-passed'));
      return;
    }
    onScrollProgress(list, (p) => {
      line.style.strokeDashoffset = String(100 - p * 100);
      const listRect = list.getBoundingClientRect();
      const drawnY = listRect.top + listRect.height * p;
      items.forEach((it) => {
        const r = it.getBoundingClientRect();
        it.classList.toggle('is-passed', r.top + 28 <= drawnY);
      });
    });
  }
  initJourney();
  document.addEventListener('astro:page-load', initJourney);
</script>

<style>
  .jr__grid { display: grid; gap: var(--s-8); }
  .jr__head { display: grid; gap: var(--s-4); align-content: start; max-width: 30rem; }
  .jr__list { position: relative; display: grid; padding-left: 2.5rem; }
  .jr__route { position: absolute; left: 0.5rem; top: 0; width: 2px; height: 100%; overflow: visible; }
  .jr__track { stroke: var(--line); stroke-width: 1; }
  .jr__line { stroke: var(--accent); stroke-width: 1.5; stroke-dasharray: 100; stroke-dashoffset: 100; }
  .jr__item { position: relative; }
  .jr__link { display: grid; grid-template-columns: auto 1fr; gap: var(--s-4); padding: 1.4rem 0; border-bottom: 1px solid var(--line); align-items: start; }
  .jr__marker { position: absolute; left: -2.5rem; top: 1.75rem; width: 0.7rem; height: 0.7rem; margin-left: 0.5rem; transform: translateX(-50%); border-radius: 50%; background: var(--bg); border: 1px solid var(--line); transition: background var(--dur-2), border-color var(--dur-2), transform var(--dur-2) var(--ease-out); }
  .is-passed .jr__marker { background: var(--accent); border-color: var(--accent); transform: translateX(-50%) scale(1.15); }
  .jr__n { padding-top: 0.35rem; }
  .jr__body { display: grid; gap: 0.45rem; }
  .jr__title { font-size: clamp(1.4rem, 2.6vw, 2rem); line-height: 1.15; letter-spacing: -0.01em; transition: color var(--dur-1); }
  .jr__line-copy { color: var(--fg-muted); max-width: 40rem; text-wrap: pretty; }
  .jr__more { justify-self: start; margin-top: 0.3rem; opacity: 0.7; transition: opacity var(--dur-1); }
  .jr__link:hover .jr__title { color: var(--accent); }
  .jr__link:hover .jr__more { opacity: 1; }
  html.no-js .jr__line { stroke-dashoffset: 0; }
  @media (min-width: 1024px) {
    .jr__grid { grid-template-columns: 4fr 8fr; column-gap: calc(var(--gutter) * 2); }
    .jr__head { position: sticky; top: 7rem; }
    .jr__list { padding-left: 4rem; }
    .jr__route { left: 1rem; }
    .jr__marker { left: -4rem; margin-left: 1rem; }
    .jr__link { grid-template-columns: 4rem 1fr; padding: 1.8rem 0; }
  }
</style>
