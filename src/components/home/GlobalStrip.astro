---
/** GlobalStrip — a restrained, non-touristic statement of markets, plus a link to the full map. */
import Title from '@components/ui/Title.astro';
import Arrow from '@components/ui/Arrow.astro';
import ImageNarrative from '@components/editorial/ImageNarrative.astro';
import skyline from '@assets/images/dario-miami-skyline.jpg';
import type { Copy } from '@i18n/index';
interface Props { copy: Copy['home']['global'] }
const { copy } = Astro.props;
---

<section class="gs section g-ivory" id="global" aria-labelledby="global-title">
  <div class="container gs__grid">
    <div class="gs__text">
      <p class="eyebrow eyebrow--rule eyebrow--accent" data-reveal>{copy.eyebrow}</p>
      <div data-reveal><Title as="h2" id="global-title" class="t-1" text={copy.title} /></div>
      <p class="lede muted" data-reveal>{copy.body}</p>
      <a class="btn" href={copy.cta.href} data-reveal data-track="cta_click" data-track-cta-name="global_career" data-track-cta-location="global">{copy.cta.label}<Arrow /></a>
    </div>
    <div class="gs__media" data-reveal>
      <ImageNarrative image={skyline} alt="Dario Picardi on the water off Miami, the city skyline behind him" ratio="16x9" treatment="warm" note="Miami · Building from here" sizes="(min-width: 1024px) 55vw, 100vw" widths={[640, 1080, 1600, 2400]} />
    </div>
  </div>
  <div class="gs__strip" aria-label="Markets and cities where the experience was built">
    <ul class="gs__marquee" role="list">
      {[...copy.strip, ...copy.strip].map((city, i) => <li aria-hidden={i >= copy.strip.length ? 'true' : undefined}>{city}</li>)}
    </ul>
  </div>
</section>

<style>
  .gs { padding-bottom: 0; overflow: hidden; }
  .gs__grid { display: grid; gap: var(--s-8); align-items: end; }
  .gs__text { display: grid; gap: var(--s-5); }
  .gs__text .btn { justify-self: start; }
  .gs__strip { margin-top: clamp(3rem, 7vw, 5.5rem); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); overflow: hidden; }
  .gs__marquee { display: flex; gap: 3rem; width: max-content; padding: 1.1rem 0; font-family: var(--font-serif); font-size: clamp(1.2rem, 2vw, 1.7rem); color: var(--fg-muted); animation: marquee 60s linear infinite; }
  .gs__marquee li { white-space: nowrap; display: flex; align-items: center; gap: 3rem; }
  .gs__marquee li::after { content: ''; width: 5px; height: 5px; border-radius: 50%; background: var(--accent); }
  @keyframes marquee { to { transform: translateX(-50%); } }
  .gs__strip:hover .gs__marquee { animation-play-state: paused; }
  @media (min-width: 1024px) {
    .gs__grid { grid-template-columns: 5fr 7fr; column-gap: calc(var(--gutter) * 2); }
  }
  @media (prefers-reduced-motion: reduce) {
    .gs__marquee { animation: none; flex-wrap: wrap; width: auto; }
    .gs__marquee li[aria-hidden] { display: none; }
  }
</style>
