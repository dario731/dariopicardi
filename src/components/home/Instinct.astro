---
/** Instinct — the merchant instinct and the four connected capabilities. */
import Title from '@components/ui/Title.astro';
import type { Copy } from '@i18n/index';
interface Props { copy: Copy['home']['instinct'] }
const { copy } = Astro.props;
---

<section class="ins section g-notte" id="instinct" aria-labelledby="instinct-title">
  <div class="container">
    <div class="ins__head">
      <p class="eyebrow eyebrow--rule eyebrow--accent" data-reveal>{copy.eyebrow}</p>
      <div data-reveal><Title as="h2" id="instinct-title" class="t-1" text={copy.title} /></div>
      <p class="lede ins__lede" data-reveal>{copy.body}</p>
    </div>
    <ol class="ins__grid" role="list" data-reveal-group>
      {copy.capabilities.map((c) => (
        <li class="cap">
          <span class="num cap__n">{c.n}</span>
          <h3 class="cap__title serif">{c.title}</h3>
          <p class="cap__body">{c.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .ins__head { display: grid; gap: var(--s-5); max-width: 52rem; margin-bottom: clamp(3rem, 7vw, 5.5rem); }
  .ins__lede { color: var(--sabbia); }
  .ins__grid { display: grid; gap: 0; border-top: 1px solid var(--line); }
  .cap { display: grid; gap: var(--s-3); padding: var(--s-6) 0; border-bottom: 1px solid var(--line); position: relative; }
  .cap__title { font-size: clamp(1.5rem, 2.4vw, 2rem); line-height: 1.15; }
  .cap__body { color: var(--pietra); max-width: 30rem; }
  @media (min-width: 900px) {
    .ins__grid { grid-template-columns: repeat(4, 1fr); border-top: 0; }
    .cap { border-bottom: 0; border-top: 1px solid var(--line); padding: var(--s-6) var(--s-5) var(--s-7) 0; }
    .cap + .cap { padding-left: var(--s-5); border-left: 1px solid var(--line); }
  }
</style>
