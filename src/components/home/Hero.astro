---
/**
 * Hero — the central creative line, set large in the serif, beside a
 * monochrome portrait. No skyline video, no counters, no noise.
 */
import { Picture } from 'astro:assets';
import Title from '@components/ui/Title.astro';
import Arrow from '@components/ui/Arrow.astro';
import portrait from '@assets/images/portrait-dario-bw-tmp.jpg';
import type { Copy } from '@i18n/index';
interface Props { copy: Copy['home']['hero'] }
const { copy } = Astro.props;
---

<section class="hero g-notte" id="hero" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__text">
      <p class="eyebrow eyebrow--rule eyebrow--accent" data-reveal>{copy.eyebrow}</p>
      <div data-reveal><Title as="h1" id="hero-title" class="t-display hero__title" text={copy.title} /></div>
      <p class="lede hero__lede" data-reveal>{copy.lede}</p>
      <div class="hero__actions" data-reveal>
        <a class="btn btn--accent" href={copy.primary.href} data-track="cta_click" data-track-cta-name="discover_story" data-track-cta-location="hero">{copy.primary.label}<Arrow /></a>
        <a class="link" href={copy.secondary.href} data-track="cta_click" data-track-cta-name="explore_biz_style" data-track-cta-location="hero">{copy.secondary.label}<Arrow /></a>
      </div>
    </div>
    <figure class="hero__fig" data-reveal>
      <div class="media media--4x5 media--mono mask hero__media">
        <Picture src={portrait} alt={copy.portraitAlt} widths={[480, 819]} sizes="(min-width: 1024px) 38vw, 90vw" formats={['avif', 'webp']} loading="eager" fetchpriority="high" decoding="async" />
      </div>
      <figcaption class="num hero__cap">Miami Beach · Portrait FOUNDER-01 (placeholder — editorial session pending)</figcaption>
    </figure>
  </div>
  <a class="hero__scroll num" href="#positioning" aria-label="Scroll to the next section">
    <span>{copy.scroll}</span>
    <span class="hero__scroll-line" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero { position: relative; min-height: 100svh; display: grid; align-items: center; padding-top: clamp(6.5rem, 14vh, 9rem); padding-bottom: clamp(5rem, 10vh, 7rem); overflow: hidden; }
  .hero::before { content: ''; position: absolute; inset: 0; background: radial-gradient(60% 50% at 80% 20%, rgba(165, 131, 79, 0.10), transparent 70%); pointer-events: none; }
  .hero__grid { position: relative; display: grid; gap: var(--s-8); align-items: center; }
  .hero__text { display: grid; gap: var(--s-6); }
  .hero__title { max-width: 12ch; }
  .hero__lede { color: var(--sabbia); max-width: 34rem; }
  .hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-5); }
  .hero__fig { display: grid; gap: var(--s-3); max-width: 30rem; }
  .hero__media { position: relative; }
  .hero__media::after { content: ''; position: absolute; inset: 0; box-shadow: inset 0 0 0 1px rgba(196, 165, 117, 0.25); pointer-events: none; }
  .hero__cap { text-transform: uppercase; }
  .hero__scroll { position: absolute; left: var(--gutter); bottom: 1.75rem; display: none; align-items: center; gap: 0.8rem; text-transform: uppercase; }
  .hero__scroll-line { display: block; width: 3.5rem; height: 1px; background: var(--bronzo-2); transform-origin: left; animation: scrollline 2.4s var(--ease-in-out) infinite; }
  @keyframes scrollline { 0% { transform: scaleX(0); } 50% { transform: scaleX(1); } 100% { transform: scaleX(0); transform-origin: right; } }
  @media (min-width: 1024px) {
    .hero__grid { grid-template-columns: 7fr 5fr; column-gap: calc(var(--gutter) * 2); }
    .hero__fig { justify-self: end; width: 100%; }
    .hero__scroll { display: inline-flex; }
  }
  @media (prefers-reduced-motion: reduce) { .hero__scroll-line { animation: none; transform: none; } }
</style>
