---
/** Statement — a full-width serif statement band, optionally with body copy and a link. */
import Title from '@components/ui/Title.astro';
import Arrow from '@components/ui/Arrow.astro';
interface Props {
  eyebrow?: string;
  title: string;
  body?: string;
  ground?: 'ivory' | 'notte' | 'lino';
  cta?: { label: string; href: string; name?: string };
  secondary?: { label: string; href: string; name?: string };
  id?: string;
  size?: 't-1' | 't-2';
}
const { eyebrow, title, body, ground = 'notte', cta, secondary, id, size = 't-1' } = Astro.props;
---
<section class:list={['stmt section', `g-${ground}`]} id={id}>
  <div class="container stmt__inner">
    {eyebrow && <p class="eyebrow eyebrow--rule eyebrow--accent" data-reveal>{eyebrow}</p>}
    <div data-reveal><Title as="h2" class={`${size} stmt__title`} text={title} /></div>
    {body && <p class="lede muted stmt__body" data-reveal>{body}</p>}
    {(cta || secondary) && (
      <div class="stmt__actions" data-reveal>
        {cta && <a class:list={['btn', ground === 'notte' ? 'btn--accent' : '']} href={cta.href} data-track="cta_click" data-track-cta-name={cta.name ?? cta.label} data-track-cta-location={id ?? 'statement'}>{cta.label}<Arrow /></a>}
        {secondary && <a class="link" href={secondary.href} data-track="cta_click" data-track-cta-name={secondary.name ?? secondary.label} data-track-cta-location={id ?? 'statement'}>{secondary.label}<Arrow /></a>}
      </div>
    )}
  </div>
</section>

<style>
  .stmt__inner { display: grid; gap: var(--s-5); max-width: 56rem; }
  .stmt__title { max-width: 20ch; }
  .stmt__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-5); margin-top: var(--s-3); }
</style>
