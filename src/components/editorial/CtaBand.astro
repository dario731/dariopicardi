---
/** CtaBand — closing invitation: statement + primary/secondary actions. */
import Title from '@components/ui/Title.astro';
import Arrow from '@components/ui/Arrow.astro';
interface Props {
  title: string;
  body?: string;
  primary: { label: string; href: string; name?: string };
  secondary?: { label: string; href: string; name?: string };
  ground?: 'ivory' | 'notte' | 'lino';
  id?: string;
}
const { title, body, primary, secondary, ground = 'ivory', id = 'closing' } = Astro.props;
const external = /^https?:/.test(primary.href);
---
<section class:list={['cta section', `g-${ground}`]} id={id}>
  <div class="container cta__inner">
    <div data-reveal><Title as="h2" class="t-1 cta__title" text={title} /></div>
    {body && <p class="lede muted" data-reveal>{body}</p>}
    <div class="cta__actions" data-reveal>
      <a class:list={['btn', ground === 'notte' ? 'btn--accent' : '']} href={primary.href} rel={external ? 'noopener' : undefined} data-track="cta_click" data-track-cta-name={primary.name ?? primary.label} data-track-cta-location={id}>{primary.label}<Arrow /></a>
      {secondary && <a class="link" href={secondary.href} data-track="cta_click" data-track-cta-name={secondary.name ?? secondary.label} data-track-cta-location={id}>{secondary.label}<Arrow /></a>}
    </div>
  </div>
</section>

<style>
  .cta__inner { display: grid; gap: var(--s-6); max-width: 60rem; }
  .cta__title { max-width: 18ch; }
  .cta__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-5); }
</style>
