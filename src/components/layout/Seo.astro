---
/**
 * Head metadata + JSON-LD. Person / Organization / WebSite are emitted on every
 * page; page-specific nodes (ProfilePage, Article, BreadcrumbList, …) are
 * passed in via `jsonLd`.
 */
import { site, localeMeta, type Locale } from '@data/site';
import { alternates } from '@i18n/index';
import { personLd, organizationLd, websiteLd } from '@lib/seo';

interface Props {
  title: string;
  description: string;
  path: string;
  type?: 'website' | 'article' | 'profile';
  image?: string;
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  jsonLd?: Record<string, unknown>[];
  locale?: Locale;
}

const { title, description, path, type = 'website', image, noindex = false, publishedTime, modifiedTime, jsonLd = [], locale = 'en' } = Astro.props;
const canonical = `${site.url}${path === '/' ? '' : path}`;
const ogImage = image ?? `${site.url}${site.seo.defaultImage}`;
const graph = { '@context': 'https://schema.org', '@graph': [personLd(), organizationLd(), websiteLd(locale), ...jsonLd] };
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}
{alternates(path).map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${site.name} — ${site.tagline}`} />
<meta property="og:locale" content={localeMeta[locale].og} />
{type === 'profile' && <meta property="profile:first_name" content={site.givenName} />}
{type === 'profile' && <meta property="profile:last_name" content={site.familyName} />}
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
{publishedTime && <meta property="article:author" content={site.name} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
{site.seo.twitterHandle && <meta name="twitter:site" content={site.seo.twitterHandle} />}

<script type="application/ld+json" set:html={JSON.stringify(graph)} />
