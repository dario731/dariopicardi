---
/**
 * KineticFrames — a pinned sequence of full-screen frames driven by scroll.
 * Each frame is one idea: a number that counts up, a single word, a short
 * statement, or a step in a sequence. Frames cut in with a scale-and-rise,
 * cut out upward. 0.7 viewports of scroll per frame keeps it rapid.
 *
 * Same engine as StageScroller: one scroll listener, renders directly when the
 * tab is hidden, stacks statically under reduced motion or without JS, and
 * every frame is real DOM in reading order.
 */
import Title from '@components/ui/Title.astro';
import Arrow from '@components/ui/Arrow.astro';

export interface Frame {
  id: string;
  kind: 'number' | 'word' | 'statement' | 'step';
  /** number: "15+", "$500M+", "1,000+" — parsed and counted up. */
  value?: string;
  /** word: the single word. statement: the sentence (supports | and <em>). step: the step name. */
  text?: string;
  /** Short label under the value / word / step. Keep it under ten words. */
  label?: string;
  /** Small eyebrow above (e.g. "01 / 06"). Generated when omitted. */
  tag?: string;
  cta?: { href: string; label: string };
}

interface Props { id: string; frames: Frame[]; label: string; ground?: 'ivory' | 'lino' | 'notte'; perFrame?: number }
const { id, frames, label, ground = 'ivory', perFrame = 0.7 } = Astro.props;
const parse = (v: string) => { const m = v.match(/^([^0-9]*)([0-9][0-9,.]*)(.*)$/); return m ? { prefix: m[1], num: parseFloat(m[2].replace(/,/g, '')), decimals: (m[2].split('.')[1] ?? '').length, commas: m[2].includes(','), suffix: m[3] } : null; };
---

<section class:list={['kf', `g-${ground}`]} id={id} data-kinetic style={`--n:${frames.length}; --per:${perFrame}`} aria-label={label}>
  <div class="kf__view">
    <ol class="kf__frames" role="list">
      {frames.map((f, i) => {
        const p = f.kind === 'number' && f.value ? parse(f.value) : null;
        return (
          <li class:list={['kf__frame', `kf__frame--${f.kind}`, { 'is-active': i === 0 }]} data-frame={i} id={`${id}-${f.id}`}>
            <div class="container kf__inner">
              <p class="kf__tag num">{f.tag ?? `${String(i + 1).padStart(2, '0')} / ${String(frames.length).padStart(2, '0')}`}</p>
              {f.kind === 'number' && p && (
                <p class="kf__value serif" data-num data-prefix={p.prefix} data-target={p.num} data-decimals={p.decimals} data-commas={p.commas ? '1' : ''} data-suffix={p.suffix}>{f.value}</p>
              )}
              {f.kind === 'word' && <p class="kf__word serif">{f.text}</p>}
              {f.kind === 'step' && <p class="kf__step serif"><span class="kf__stepname">{f.text}</span></p>}
              {f.kind === 'statement' && <Title as="h2" class="t-1 kf__statement" text={f.text ?? ''} />}
              {f.label && <p class="kf__label">{f.label}</p>}
              {f.cta && <a class="btn kf__cta" href={f.cta.href} data-track="cta_click" data-track-cta-name={`frame_${f.id}`} data-track-cta-location={id}>{f.cta.label}<Arrow /></a>}
            </div>
          </li>
        );
      })}
    </ol>
    <div class="kf__progress" aria-hidden="true"><span data-progress></span></div>
  </div>
</section>

<script>
  import { reducedMotion } from '@lib/reveal';
  function initKinetic() {
    document.querySelectorAll<HTMLElement>('[data-kinetic]').forEach((root) => {
      if (root.dataset.bound) return;
      root.dataset.bound = '1';
      const frames = Array.from(root.querySelectorAll<HTMLElement>('[data-frame]'));
      const bar = root.querySelector<HTMLElement>('[data-progress]')!;
      const n = frames.length;
      const fmt = (el: HTMLElement, v: number) => {
        const d = Number(el.dataset.decimals || 0);
        const s = v.toFixed(d);
        const num = el.dataset.commas ? Number(s).toLocaleString('en-US', { minimumFractionDigits: d }) : s;
        el.textContent = `${el.dataset.prefix ?? ''}${num}${el.dataset.suffix ?? ''}`;
      };
      if (reducedMotion()) { root.classList.add('is-static'); return; }
      const ease = (t: number) => 1 - Math.pow(1 - t, 3);
      let ticking = false, lastK = -1;
      const render = () => {
        ticking = false;
        const r = root.getBoundingClientRect();
        const vh = window.innerHeight;
        const total = Math.max(1, r.height - vh);
        const p = Math.min(1, Math.max(0, -r.top / total));
        const pos = Math.min(n - 0.5, p * (n - 0.5));
        const k = Math.min(n - 1, Math.floor(pos));
        const t = pos - k;
        frames.forEach((fr, i) => {
          let o = 0, y = 40, s = 0.92;
          if (i === k) {
            const inT = Math.min(1, t / 0.18), outT = Math.max(0, (t - 0.86) / 0.14);
            o = ease(inT) * (1 - outT); y = 40 * (1 - ease(inT)) - 40 * outT; s = 0.92 + 0.08 * ease(inT);
            if (i === 0 && t < 0.18) { o = 1; y = 0; s = 1; }
            if (i === n - 1 && t > 0.86) { o = 1; y = 0; s = 1; }
            const num = fr.querySelector<HTMLElement>('[data-num]');
            if (num) fmt(num, Number(num.dataset.target) * ease(Math.min(1, t / 0.45)));
          }
          fr.style.setProperty('--o', o.toFixed(3)); fr.style.setProperty('--y', `${y.toFixed(1)}px`); fr.style.setProperty('--s', s.toFixed(3));
        });
        bar.style.transform = `scaleX(${p.toFixed(4)})`;
        if (k !== lastK) { frames.forEach((f, i) => f.classList.toggle('is-active', i === k)); lastK = k; }
      };
      const onScroll = () => { if (document.hidden) { render(); return; } if (!ticking) { ticking = true; requestAnimationFrame(render); } };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll);
      render();
    });
  }
  initKinetic();
  document.addEventListener('astro:page-load', initKinetic);
</script>

<style>
  .kf { position: relative; height: calc(var(--n) * var(--per) * 100svh + 50svh); border-top: 1px solid var(--line); }
  .kf__view { position: sticky; top: 0; height: 100svh; overflow: hidden; }
  .kf__frames { position: absolute; inset: 0; }
  .kf__frame { position: absolute; inset: 0; display: grid; align-items: center; opacity: var(--o, 0); transform: translateY(var(--y, 40px)) scale(var(--s, 0.92)); transform-origin: left center; pointer-events: none; will-change: opacity, transform; }
  .kf__frame.is-active { pointer-events: auto; }
  .kf__inner { display: grid; gap: var(--s-4); }
  .kf__tag { color: var(--accent); }
  .kf__value { font-size: clamp(5rem, 20vw, 17rem); line-height: 0.9; letter-spacing: -0.04em; font-variant-numeric: tabular-nums; font-weight: 400; }
  .kf__word { font-size: clamp(4rem, 15vw, 13rem); line-height: 0.92; letter-spacing: -0.035em; }
  .kf__step { font-size: clamp(3.4rem, 12vw, 11rem); line-height: 0.92; letter-spacing: -0.03em; }
  .kf__statement { max-width: 16ch; }
  .kf__label { font-size: var(--fs-lede); color: var(--fg-muted); max-width: 30rem; text-wrap: balance; }
  .kf__cta { justify-self: start; margin-top: var(--s-3); }
  .kf__progress { position: absolute; left: 0; right: 0; top: 0; height: 2px; background: var(--line); }
  .kf__progress span { display: block; height: 100%; background: var(--accent); transform: scaleX(0); transform-origin: left; }
  html.no-js .kf, .kf.is-static { height: auto; }
  html.no-js .kf__view, .kf.is-static .kf__view { position: relative; height: auto; overflow: visible; }
  html.no-js .kf__frames, .kf.is-static .kf__frames { position: relative; display: grid; }
  html.no-js .kf__frame, .kf.is-static .kf__frame { position: relative; opacity: 1; transform: none; padding-block: var(--section-sm); border-top: 1px solid var(--line); pointer-events: auto; }
  html.no-js .kf__progress, .kf.is-static .kf__progress { display: none; }
</style>
