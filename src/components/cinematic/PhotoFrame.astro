---
/**
 * PhotoFrame — one full-bleed photograph, one line. The image drifts and
 * scales with the scroll through CSS scroll-driven animation (no JS) where
 * supported; elsewhere it is simply still.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Title from '@components/ui/Title.astro';
import Arrow from '@components/ui/Arrow.astro';
interface Props { id: string; image: ImageMetadata; alt: string; eyebrow?: string; title: string; cta?: { href: string; label: string }; position?: string }
const { id, image, alt, eyebrow, title, cta, position = 'center' } = Astro.props;
---

<section class="pf" id={id} aria-labelledby={`${id}-title`}>
  <div class="pf__media" style={`--pos:${position}`}>
    <Picture src={image} {alt} widths={[768, 1280, 1920, 2560]} sizes="100vw" formats={['avif', 'webp']} loading="lazy" decoding="async" />
  </div>
  <div class="pf__scrim" aria-hidden="true"></div>
  <div class="container pf__text">
    {eyebrow && <p class="eyebrow eyebrow--rule pf__eyebrow" data-reveal>{eyebrow}</p>}
    <div data-reveal><Title as="h2" id={`${id}-title`} class="t-1 pf__title" text={title} /></div>
    {cta && <a class="btn pf__cta" href={cta.href} data-reveal data-track="cta_click" data-track-cta-name={`photo_${id}`} data-track-cta-location={id}>{cta.label}<Arrow /></a>}
  </div>
</section>

<style>
  .pf { position: relative; min-height: 100svh; display: grid; align-items: end; overflow: hidden; color: #fff; background: var(--notte); }
  .pf__media { position: absolute; inset: -10% 0; }
  .pf__media :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: var(--pos); }
  .pf__scrim { position: absolute; inset: 0; background: linear-gradient(to top, rgba(11, 11, 12, 0.72) 0%, rgba(11, 11, 12, 0.15) 50%, rgba(11, 11, 12, 0) 100%); }
  .pf__text { position: relative; display: grid; gap: var(--s-5); padding-block: clamp(3rem, 8vh, 6rem); }
  .pf__eyebrow { color: rgba(255, 255, 255, 0.75); }
  .pf__eyebrow::before { background: #fff; }
  .pf__title { max-width: 16ch; color: #fff; }
  .pf__cta { --btn-bg: #fff; --btn-fg: var(--notte); justify-self: start; }
  @supports (animation-timeline: view()) {
    .pf__media { animation: drift linear both; animation-timeline: view(); animation-range: entry 0% exit 100%; }
    @keyframes drift { from { transform: translateY(-6%) scale(1.08); } to { transform: translateY(6%) scale(1); } }
  }
  @media (prefers-reduced-motion: reduce) { .pf__media { animation: none; transform: none; } }
</style>
