---
/**
 * GlobalMap — a lightweight, accessible world map of verified places. Land is a
 * single generated path (Natural Earth 110m, equirectangular). Arcs connect
 * Calabria → the markets → Miami and draw on entry. Every point is a real
 * <button> with a tooltip; the same data is rendered as a list below for
 * screen readers, keyboards and no-JS.
 */
import { getCollection } from 'astro:content';
import Title from '@components/ui/Title.astro';
import { WORLD_PATH, WORLD_W, WORLD_H } from '@lib/world-path';
import type { Copy } from '@i18n/index';
interface Props { copy: Copy['career']['map'] }
const { copy } = Astro.props;

const places = (await getCollection('places')).map((p) => p.data);
// Same projection as scripts/world.mjs
const LAT_MAX = 84, LAT_MIN = -58;
const px = (lng: number) => ((lng + 180) / 360) * WORLD_W;
const py = (lat: number) => ((LAT_MAX - lat) / (LAT_MAX - LAT_MIN)) * WORLD_H;
// Crop the viewBox to the used band: lng -125…125, lat 62…-45
const vb = { x: px(-125), y: py(62), w: px(125) - px(-125), h: py(-45) - py(62) };
const pts = places.map((p) => ({ ...p, x: +px(p.lng).toFixed(1), y: +py(p.lat).toFixed(1) }));
const miami = pts.find((p) => p.id === 'miami')!;
const calabria = pts.find((p) => p.id === 'calabria')!;
const arc = (a: { x: number; y: number }, b: { x: number; y: number }, lift = 0.18) => {
  const mx = (a.x + b.x) / 2, my = (a.y + b.y) / 2;
  const dx = b.x - a.x, dy = b.y - a.y;
  const cx = mx + dy * lift, cy = my - dx * lift;
  return `M${a.x} ${a.y} Q${cx.toFixed(1)} ${cy.toFixed(1)} ${b.x} ${b.y}`;
};
const arcs = pts.filter((p) => p.id !== 'miami' && p.id !== 'calabria').map((p, i) => ({ id: p.id, d: arc(p.x < miami.x ? miami : p, p.x < miami.x ? p : miami, i % 2 ? 0.14 : -0.14) }));
const rootArc = arc(calabria, miami, -0.22);
const roleLabel = Object.fromEntries(copy.legend.map((l) => [l.id, l.label]));
roleLabel.education = roleLabel.roots;
---

<section class="gm section g-notte" id="map" aria-labelledby="map-title" data-map>
  <div class="container">
    <div class="section-head">
      <p class="eyebrow eyebrow--rule eyebrow--accent" data-reveal>{copy.eyebrow}</p>
      <div data-reveal><Title as="h2" id="map-title" class="t-1" text={copy.title} /></div>
      <p class="lede muted" data-reveal>{copy.body}</p>
    </div>

    <div class="gm__stage" data-reveal>
      <svg class="gm__svg" viewBox={`${vb.x.toFixed(1)} ${vb.y.toFixed(1)} ${vb.w.toFixed(1)} ${vb.h.toFixed(1)}`} role="img" aria-labelledby="map-svg-title" aria-describedby="map-list-title">
        <title id="map-svg-title">World map of the markets where Dario Picardi built operating experience, with routes converging on Miami</title>
        <path class="gm__land" d={WORLD_PATH} />
        <path class="gm__arc gm__arc--root" d={rootArc} pathLength="100" />
        {arcs.map((a, i) => <path class="gm__arc" d={a.d} pathLength="100" style={`--i:${i}`} data-arc={a.id} />)}
        {pts.map((p) => (
          <g class:list={['gm__pt', `gm__pt--${p.role}`]} data-pt={p.id} transform={`translate(${p.x} ${p.y})`}>
            {p.role === 'base' && <circle class="gm__ring" r="9" />}
            <circle class="gm__dot" r={p.role === 'base' ? 4 : 2.8} />
            <text class:list={['gm__label', `gm__label--${p.labelSide}`]}>{p.name}</text>
          </g>
        ))}
      </svg>
      <div class="gm__hotspots" aria-hidden="true">
        {pts.map((p) => (
          <button class="gm__hot" type="button" tabindex="-1" data-hot={p.id} style={`left:${(((p.x - vb.x) / vb.w) * 100).toFixed(2)}%; top:${(((p.y - vb.y) / vb.h) * 100).toFixed(2)}%`}>
            <span class="sr-only">{p.name}</span>
          </button>
        ))}
      </div>
      <div class="gm__tip" data-tip hidden>
        <p class="gm__tip-name serif" data-tip-name></p>
        <p class="gm__tip-role num" data-tip-role></p>
        <p class="gm__tip-note small" data-tip-note></p>
      </div>
      <ul class="gm__legend" role="list">
        {copy.legend.map((l) => <li class:list={['gm__legend-item', `gm__legend-item--${l.id}`]}><span class="gm__legend-dot" aria-hidden="true"></span>{l.label}</li>)}
      </ul>
    </div>

    <div class="gm__list" data-reveal>
      <h3 id="map-list-title" class="eyebrow">{copy.listTitle}</h3>
      <p class="small muted">{copy.hint}</p>
      <ol class="gm__places" role="list">
        {pts.map((p) => (
          <li>
            <button class="gm__place" type="button" data-place={p.id} aria-pressed="false" data-track="map_interaction" data-track-item={p.id}>
              <span class="gm__place-head">
                <span class:list={['gm__legend-dot', `gm__legend-dot--${p.role}`]} aria-hidden="true"></span>
                <span class="gm__place-name serif">{p.name}</span>
                <span class="num">{p.country}</span>
              </span>
              <span class="gm__place-role num">{roleLabel[p.role]}</span>
              <span class="gm__place-note small">{p.note}</span>
            </button>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<script>
  function initMap() {
    const root = document.querySelector<HTMLElement>('[data-map]');
    if (!root || root.dataset.bound) return;
    root.dataset.bound = '1';
    const tip = root.querySelector<HTMLElement>('[data-tip]')!;
    const tipName = tip.querySelector<HTMLElement>('[data-tip-name]')!;
    const tipRole = tip.querySelector<HTMLElement>('[data-tip-role]')!;
    const tipNote = tip.querySelector<HTMLElement>('[data-tip-note]')!;
    const stage = root.querySelector<HTMLElement>('.gm__stage')!;
    const places = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-place]'));
    const hots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-hot]'));
    let active: string | null = null;

    const setActive = (id: string | null, source: 'map' | 'list' = 'list') => {
      active = id;
      root.querySelectorAll<SVGGElement>('[data-pt]').forEach((g) => g.classList.toggle('is-active', g.dataset.pt === id));
      root.querySelectorAll<SVGPathElement>('[data-arc]').forEach((a) => a.classList.toggle('is-active', a.dataset.arc === id));
      places.forEach((b) => { b.setAttribute('aria-pressed', b.dataset.place === id ? 'true' : 'false'); b.classList.toggle('is-active', b.dataset.place === id); });
      if (!id) { tip.hidden = true; return; }
      const btn = places.find((b) => b.dataset.place === id);
      const hot = hots.find((h) => h.dataset.hot === id);
      if (!btn || !hot) return;
      tipName.textContent = btn.querySelector('.gm__place-name')?.textContent ?? '';
      tipRole.textContent = btn.querySelector('.gm__place-role')?.textContent ?? '';
      tipNote.textContent = btn.querySelector('.gm__place-note')?.textContent ?? '';
      tip.hidden = false;
      const left = parseFloat(hot.style.left), top = parseFloat(hot.style.top);
      tip.style.left = `${Math.min(Math.max(left, 18), 82)}%`;
      tip.style.top = `${top}%`;
      tip.classList.toggle('gm__tip--below', top < 30);
      if (source === 'map') btn.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    };

    hots.forEach((h) => {
      h.addEventListener('mouseenter', () => setActive(h.dataset.hot ?? null, 'map'));
      h.addEventListener('click', () => setActive(h.dataset.hot ?? null, 'map'));
    });
    stage.addEventListener('mouseleave', () => { if (active && !places.some((b) => b.classList.contains('is-focus'))) setActive(null); });
    places.forEach((b, i) => {
      b.addEventListener('click', () => setActive(active === b.dataset.place ? null : (b.dataset.place ?? null)));
      b.addEventListener('focus', () => { b.classList.add('is-focus'); setActive(b.dataset.place ?? null); });
      b.addEventListener('blur', () => b.classList.remove('is-focus'));
      b.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown' || e.key === 'ArrowRight') { e.preventDefault(); places[(i + 1) % places.length].focus(); }
        if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') { e.preventDefault(); places[(i - 1 + places.length) % places.length].focus(); }
        if (e.key === 'Escape') setActive(null);
      });
    });
    const io = new IntersectionObserver((entries) => entries.forEach((e) => { if (e.isIntersecting) { root.classList.add('is-drawn'); io.disconnect(); } }), { threshold: 0.25 });
    io.observe(stage);
  }
  initMap();
  document.addEventListener('astro:page-load', initMap);
</script>

<style>
  .gm__stage { position: relative; border: 1px solid var(--line); background: radial-gradient(90% 80% at 50% 40%, rgba(30, 76, 99, 0.16), transparent 75%), var(--surface); padding: clamp(0.5rem, 2vw, 1.5rem); }
  .gm__svg { width: 100%; height: auto; display: block; font-family: var(--font-sans); overflow: visible; }
  .gm__land { fill: #221f1a; stroke: #3b362e; stroke-width: 0.6; vector-effect: non-scaling-stroke; }
  .gm__arc { fill: none; stroke: var(--sabbia); stroke-opacity: 0.35; stroke-width: 0.9; vector-effect: non-scaling-stroke; stroke-dasharray: 100; stroke-dashoffset: 100; transition: stroke-dashoffset 1.6s var(--ease-out), stroke-opacity var(--dur-2), stroke var(--dur-2); transition-delay: calc(var(--i, 0) * 70ms + 300ms); }
  .gm__arc--root { stroke: var(--accent); stroke-opacity: 0.9; stroke-width: 1.4; transition-delay: 0ms; }
  .is-drawn .gm__arc, html.no-js .gm__arc { stroke-dashoffset: 0; }
  .gm__arc.is-active { stroke: var(--accent); stroke-opacity: 1; stroke-width: 1.6; }
  .gm__dot { fill: var(--sabbia); transition: fill var(--dur-1), r var(--dur-1); }
  .gm__pt--roots .gm__dot, .gm__pt--education .gm__dot { fill: var(--accent); }
  .gm__pt--base .gm__dot { fill: var(--accent); }
  .gm__ring { fill: none; stroke: var(--accent); stroke-width: 0.8; vector-effect: non-scaling-stroke; opacity: 0.7; animation: ring 3.2s var(--ease-in-out) infinite; transform-origin: center; transform-box: fill-box; }
  @keyframes ring { 0% { transform: scale(0.6); opacity: 0.9; } 100% { transform: scale(1.6); opacity: 0; } }
  .gm__label { font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; fill: var(--sabbia); paint-order: stroke; stroke: var(--surface); stroke-width: 3px; stroke-linejoin: round; transition: fill var(--dur-1); }
  .gm__label--right { transform: translate(8px, 4px); }
  .gm__label--left { transform: translate(-8px, 4px); text-anchor: end; }
  .gm__label--top { transform: translate(0, -9px); text-anchor: middle; }
  .gm__label--bottom { transform: translate(0, 16px); text-anchor: middle; }
  .gm__pt.is-active .gm__dot { fill: var(--avorio); }
  .gm__pt.is-active .gm__label { fill: var(--avorio); }
  .gm__hotspots { position: absolute; inset: clamp(0.5rem, 2vw, 1.5rem); pointer-events: none; }
  .gm__hot { position: absolute; width: 2.2rem; height: 2.2rem; transform: translate(-50%, -50%); border-radius: 50%; pointer-events: auto; cursor: pointer; }
  .gm__tip { position: absolute; z-index: 2; transform: translate(-50%, calc(-100% - 14px)); width: min(20rem, 70%); padding: 0.9rem 1rem; background: var(--notte); border: 1px solid var(--grafite); box-shadow: 0 20px 40px -20px rgba(0, 0, 0, 0.7); pointer-events: none; display: grid; gap: 0.25rem; }
  .gm__tip--below { transform: translate(-50%, 14px); }
  .gm__tip-name { font-size: 1.25rem; }
  .gm__tip-note { color: var(--sabbia); }
  .gm__legend { display: flex; flex-wrap: wrap; gap: 0.6rem 1.4rem; padding-top: var(--s-4); font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--pietra); }
  .gm__legend-item { display: inline-flex; align-items: center; gap: 0.5rem; }
  .gm__legend-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--sabbia); flex: none; }
  .gm__legend-item--roots .gm__legend-dot, .gm__legend-dot--roots, .gm__legend-dot--education { background: var(--accent); }
  .gm__legend-item--affiliate .gm__legend-dot, .gm__legend-dot--affiliate { background: var(--sabbia); box-shadow: 0 0 0 2px var(--surface), 0 0 0 3px var(--sabbia); }
  .gm__legend-item--base .gm__legend-dot, .gm__legend-dot--base { background: var(--accent); box-shadow: 0 0 0 2px var(--surface), 0 0 0 3px var(--accent); }
  .gm__list { margin-top: var(--s-8); display: grid; gap: var(--s-4); }
  .gm__places { display: grid; border-top: 1px solid var(--line); }
  .gm__place { display: grid; gap: 0.3rem; width: 100%; text-align: left; padding: 0.95rem 0.5rem; border-bottom: 1px solid var(--line); transition: background var(--dur-1); }
  .gm__place:hover, .gm__place.is-active { background: var(--surface); }
  .gm__place-head { display: flex; align-items: baseline; gap: 0.7rem; flex-wrap: wrap; }
  .gm__place-name { font-size: 1.3rem; }
  .gm__place-note { color: var(--pietra); max-width: 60ch; }
  @media (min-width: 900px) {
    .gm__places { grid-template-columns: 1fr 1fr; column-gap: var(--s-6); }
    .gm__label { font-size: 10px; }
  }
  @media (max-width: 640px) {
    .gm__label { font-size: 15px; }
    .gm__tip { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .gm__ring { animation: none; } .gm__arc { transition: none; stroke-dashoffset: 0; } }
</style>
