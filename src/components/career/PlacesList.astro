---
/** PlacesList — the map as a compact, accessible list: place, country, role. Notes on hover/focus. */
import { getCollection } from 'astro:content';
import Title from '@components/ui/Title.astro';
import type { Copy } from '@i18n/index';
interface Props { copy: Copy['career']['map'] }
const { copy } = Astro.props;
const order = { base: 0, hub: 1, affiliate: 2, roots: 3, education: 4 } as const;
const places = (await getCollection('places')).map((p) => p.data).sort((a, b) => order[a.role] - order[b.role] || a.name.localeCompare(b.name));
const roleLabel = Object.fromEntries(copy.legend.map((l) => [l.id, l.label])) as Record<string, string>;
roleLabel.education = roleLabel.roots;
---

<section class="pl section g-ivory" id="map" aria-labelledby="map-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow eyebrow--rule eyebrow--accent" data-reveal>{copy.eyebrow}</p>
      <div data-reveal><Title as="h2" id="map-title" class="t-1" text={copy.title} /></div>
    </div>
    <ul class="pl__grid" role="list" data-reveal-group>
      {places.map((p) => (
        <li class:list={['pl__item', `pl__item--${p.role}`]}>
          <span class="pl__name serif">{p.name}</span>
          <span class="pl__meta num">{p.country} · {roleLabel[p.role]}</span>
          <span class="pl__note small muted">{p.note}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .pl__grid { display: grid; gap: var(--s-3); }
  .pl__item { display: grid; gap: 0.2rem; padding: var(--s-4) var(--s-5); border: 1px solid var(--line); border-radius: 4px; transition: border-color var(--dur-1), transform var(--dur-2) var(--ease-out); }
  .pl__item:hover { border-color: var(--inchiostro); transform: translateY(-2px); }
  .pl__item--base { border-color: var(--bronzo); }
  .pl__name { font-size: 1.5rem; line-height: 1.1; }
  .pl__meta { text-transform: uppercase; }
  .pl__note { margin-top: 0.3rem; text-wrap: pretty; }
  @media (min-width: 720px) { .pl__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .pl__grid { grid-template-columns: repeat(4, 1fr); } }
</style>
